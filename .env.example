# Copy to .env (Node backend / Java backend) or .env.local (Vite) and fill in real values.
# Never commit the filled-in copy.

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# Java backend only: database name. Defaults to "test", where Mongoose stored the existing data.
MONGO_DATABASE=test

# Node backend port (current frontend default is 5001). The Java backend defaults to 8080.
PORT=5001

# Secret used to sign login tokens (Phase 2). Use a long random value.
JWT_SECRET=

# Java backend: comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# React app: which backend to call. Use http://localhost:8080/api for the Java backend.
VITE_API_URL=http://localhost:5001/api
